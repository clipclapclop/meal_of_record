#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

if ! command -v java >/dev/null 2>&1; then
  echo "Java is required but was not found on PATH." >&2
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required but was not found on PATH." >&2
  exit 1
fi
if ! command -v flutter >/dev/null 2>&1; then
  echo "Flutter is required but was not found on PATH." >&2
  exit 1
fi

python3 - "$repository_root" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
properties_path = root / "android" / "key.properties"
if not properties_path.is_file():
    raise SystemExit("Local Android signing configuration is missing.")

values = {}
for line in properties_path.read_text().splitlines():
    stripped = line.lstrip()
    if stripped.startswith(("#", "!")) or "=" not in line:
        continue
    key, value = line.split("=", 1)
    values[key.strip()] = value.strip()

required = {"storeFile", "storePassword", "keyPassword", "keyAlias"}
if missing := sorted(required - values.keys()):
    raise SystemExit("Signing configuration is incomplete: " + ", ".join(missing))

keystore = Path(values["storeFile"]).expanduser()
if not keystore.is_absolute():
    keystore = root / "android" / "app" / keystore
keystore = keystore.resolve()
if not keystore.is_file():
    raise SystemExit("The configured Android keystore does not exist.")

for path in (properties_path, keystore):
    if path.stat().st_mode & 0o077:
        raise SystemExit("Signing files must be owner-only (run chmod 600 on both files).")
PY

flutter_sdk="$({ flutter --version --machine 2>/dev/null || true; } | python3 -c '
import json
import sys
try:
    value = json.load(sys.stdin).get("flutterRoot", "")
except (json.JSONDecodeError, AttributeError):
    value = ""
if not value:
    raise SystemExit(1)
print(value)
')" || {
  echo "The Flutter SDK root could not be determined." >&2
  exit 1
}
flutter pub get --directory "$repository_root" --enforce-lockfile --offline

python3 - "$repository_root" "$flutter_sdk" <<'PY'
from pathlib import Path
import os
import re
import sys

root = Path(sys.argv[1])
flutter_sdk = Path(sys.argv[2]).resolve()
if not (flutter_sdk / "bin" / "flutter").is_file():
    raise SystemExit("The Flutter SDK root is invalid.")
pubspec = (root / "pubspec.yaml").read_text(encoding="utf-8")
matches = re.findall(
    r"(?m)^version:\s*((?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
    r"(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)\+([0-9]+)\s*$",
    pubspec,
)
if len(matches) != 1:
    raise SystemExit("pubspec.yaml must contain one semantic version and Android build number.")
version_name, version_code = matches[0]
if int(version_code) < 1:
    raise SystemExit("The Android build number must be positive.")

properties_path = root / "android" / "local.properties"
values = {}
if properties_path.is_file():
    for line in properties_path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith(("#", "!")):
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
android_sdk = os.environ.get("ANDROID_SDK_ROOT") or os.environ.get("ANDROID_HOME")
if android_sdk:
    values["sdk.dir"] = str(Path(android_sdk).expanduser().resolve())
values["flutter.sdk"] = str(flutter_sdk)
values["flutter.buildMode"] = "release"
values["flutter.versionName"] = version_name
values["flutter.versionCode"] = version_code
if "sdk.dir" not in values:
    raise SystemExit("The Android SDK path is unavailable.")
properties_path.write_text(
    "".join(f"{key}={values[key]}\n" for key in sorted(values)),
    encoding="utf-8",
)
PY

rm -rf "$repository_root/build/app/outputs" "$repository_root/build/release"
"$repository_root/android/gradlew" \
  -p "$repository_root/android" \
  assembleRelease \
  -Ptarget-platform=android-arm64 \
  -Pdisable-abi-filtering=true \
  -PmealOfRecordReleaseArm64=true \
  -Ptarget=lib/main.dart \
  -Pbase-application-name=android.app.Application \
  "$@"

gradle_apk="$repository_root/build/app/outputs/apk/release/app-release.apk"
release_apk="$repository_root/build/release/meal-of-record-arm64-v8a.apk"
if [[ ! -f "$gradle_apk" ]]; then
  echo "Gradle did not produce the expected release APK." >&2
  exit 1
fi
install -D -m 600 "$gradle_apk" "$release_apk"
printf 'Signed arm64-v8a APK: %s\n' "$release_apk"
